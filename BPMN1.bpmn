<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Deposit" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Antigravity AI" exporterVersion="1.0">
  <bpmn:collaboration id="Collaboration_Deposit">
    <bpmn:participant id="Participant_User" name="Người dùng (User)" processRef="Process_User" />
    <bpmn:participant id="Participant_System" name="Hệ thống E-Learning (FSE)" processRef="Process_Backend" />
    <bpmn:participant id="Participant_PayOS" name="Cổng thanh toán (PayOS)" />
    <bpmn:messageFlow id="Flow_Request" name="Request" sourceRef="Activity_InputAmount" targetRef="StartEvent_Request" />
    <bpmn:messageFlow id="Flow_ToPayOS" name="API Call" sourceRef="Activity_GenerateLink" targetRef="Participant_PayOS" />
    <bpmn:messageFlow id="Flow_Webhook" name="Webhook" sourceRef="Participant_PayOS" targetRef="StartEvent_Webhook" />
  </bpmn:collaboration>

  <bpmn:process id="Process_User" isExecutable="false">
    <bpmn:laneSet id="LaneSet_User">
      <bpmn:lane id="Lane_UI" name="Frontend (React)">
        <bpmn:flowNodeRef>Activity_InputAmount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_ShowQR</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_User</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_User</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_User" name="Bắt đầu nạp">
      <bpmn:outgoing>Flow_U1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Activity_InputAmount" name="Chọn số tiền và Nạp">
      <bpmn:incoming>Flow_U1</bpmn:incoming>
      <bpmn:outgoing>Flow_U2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Activity_ShowQR" name="Quét VietQR trên PayOS">
      <bpmn:incoming>Flow_U2</bpmn:incoming>
      <bpmn:outgoing>Flow_U3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_User" name="Chờ kết quả">
      <bpmn:incoming>Flow_U3</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_U1" sourceRef="StartEvent_User" targetRef="Activity_InputAmount" />
    <bpmn:sequenceFlow id="Flow_U2" sourceRef="Activity_InputAmount" targetRef="Activity_ShowQR" />
    <bpmn:sequenceFlow id="Flow_U3" sourceRef="Activity_ShowQR" targetRef="EndEvent_User" />
  </bpmn:process>

  <bpmn:process id="Process_Backend" isExecutable="true">
    <bpmn:laneSet id="LaneSet_Backend">
      <bpmn:lane id="Lane_API" name="API / Service">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Idempotency</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_IsNew</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_CreatePending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_GenerateLink</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Pending</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Webhook</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_VerifySign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SignValid</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_PostLogic</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Domain" name="Domain / Wallet">
        <bpmn:flowNodeRef>Activity_UpdateBalance</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Audit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_Notify</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Success</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Request" name="Request">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_Idempotency" name="Check Idempotency">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_IsNew" name="Mới?">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F_New</bpmn:outgoing>
      <bpmn:outgoing>F_Exists</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_CreatePending" name="Tạo Pending Record">
      <bpmn:incoming>F_New</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_GenerateLink" name="Tạo PayOS Link">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:incoming>F_Exists</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Pending" name="Pending">
      <bpmn:incoming>F4</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:startEvent id="StartEvent_Webhook" name="Webhook">
      <bpmn:outgoing>W1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Activity_VerifySign" name="Verify Signature">
      <bpmn:incoming>W1</bpmn:incoming>
      <bpmn:outgoing>W2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_SignValid" name="Hợp lệ?">
      <bpmn:incoming>W2</bpmn:incoming>
      <bpmn:outgoing>W_Valid</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Activity_PostLogic" name="Post Payment">
      <bpmn:incoming>W_Valid</bpmn:incoming>
      <bpmn:outgoing>W3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_UpdateBalance" name="Cộng số dư Ví">
      <bpmn:incoming>W3</bpmn:incoming>
      <bpmn:outgoing>W4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Audit" name="Ghi Audit Log">
      <bpmn:incoming>W4</bpmn:incoming>
      <bpmn:outgoing>W5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Activity_Notify" name="Gửi Thông báo">
      <bpmn:incoming>W5</bpmn:incoming>
      <bpmn:outgoing>W_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Success" name="Success">
      <bpmn:incoming>W_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_Request" targetRef="Activity_Idempotency" />
    <bpmn:sequenceFlow id="F2" sourceRef="Activity_Idempotency" targetRef="Gateway_IsNew" />
    <bpmn:sequenceFlow id="F_New" name="Có" sourceRef="Gateway_IsNew" targetRef="Activity_CreatePending" />
    <bpmn:sequenceFlow id="F_Exists" name="Không" sourceRef="Gateway_IsNew" targetRef="Activity_GenerateLink" />
    <bpmn:sequenceFlow id="F3" sourceRef="Activity_CreatePending" targetRef="Activity_GenerateLink" />
    <bpmn:sequenceFlow id="F4" sourceRef="Activity_GenerateLink" targetRef="EndEvent_Pending" />
    <bpmn:sequenceFlow id="W1" sourceRef="StartEvent_Webhook" targetRef="Activity_VerifySign" />
    <bpmn:sequenceFlow id="W2" sourceRef="Activity_VerifySign" targetRef="Gateway_SignValid" />
    <bpmn:sequenceFlow id="W_Valid" name="Có" sourceRef="Gateway_SignValid" targetRef="Activity_PostLogic" />
    <bpmn:sequenceFlow id="W3" sourceRef="Activity_PostLogic" targetRef="Activity_UpdateBalance" />
    <bpmn:sequenceFlow id="W4" sourceRef="Activity_UpdateBalance" targetRef="Activity_Audit" />
    <bpmn:sequenceFlow id="W5" sourceRef="Activity_Audit" targetRef="Activity_Notify" />
    <bpmn:sequenceFlow id="W_End" sourceRef="Activity_Notify" targetRef="EndEvent_Success" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_Deposit">
      <bpmndi:BPMNShape id="Participant_User_di" bpmnElement="Participant_User" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1050" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_System_di" bpmnElement="Participant_System" isHorizontal="true">
        <dc:Bounds x="160" y="280" width="1050" height="420" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Participant_PayOS_di" bpmnElement="Participant_PayOS" isHorizontal="true">
        <dc:Bounds x="160" y="730" width="1050" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_UI_di" bpmnElement="Lane_UI" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="1020" height="180" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_API_di" bpmnElement="Lane_API" isHorizontal="true">
        <dc:Bounds x="190" y="280" width="1020" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Domain_di" bpmnElement="Lane_Domain" isHorizontal="true">
        <dc:Bounds x="190" y="500" width="1020" height="200" />
      </bpmndi:BPMNShape>
      <!-- User Flow -->
      <bpmndi:BPMNShape id="StartEvent_User_di" bpmnElement="StartEvent_User"><dc:Bounds x="210" y="150" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_InputAmount_di" bpmnElement="Activity_InputAmount"><dc:Bounds x="300" y="128" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_ShowQR_di" bpmnElement="Activity_ShowQR"><dc:Bounds x="650" y="128" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_User_di" bpmnElement="EndEvent_User"><dc:Bounds x="1100" y="150" width="36" height="36" /></bpmndi:BPMNShape>
      <!-- Backend Phase 1 -->
      <bpmndi:BPMNShape id="StartEvent_Request_di" bpmnElement="StartEvent_Request"><dc:Bounds x="210" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Idempotency_di" bpmnElement="Activity_Idempotency"><dc:Bounds x="300" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_IsNew_di" bpmnElement="Gateway_IsNew" isMarkerVisible="true"><dc:Bounds x="455" y="335" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_CreatePending_di" bpmnElement="Activity_CreatePending"><dc:Bounds x="550" y="290" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_GenerateLink_di" bpmnElement="Activity_GenerateLink"><dc:Bounds x="750" y="320" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Pending_di" bpmnElement="EndEvent_Pending"><dc:Bounds x="900" y="342" width="36" height="36" /></bpmndi:BPMNShape>
      <!-- Webhook Flow -->
      <bpmndi:BPMNShape id="StartEvent_Webhook_di" bpmnElement="StartEvent_Webhook"><dc:Bounds x="210" y="422" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_VerifySign_di" bpmnElement="Activity_VerifySign"><dc:Bounds x="300" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_SignValid_di" bpmnElement="Gateway_SignValid" isMarkerVisible="true"><dc:Bounds x="455" y="415" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_PostLogic_di" bpmnElement="Activity_PostLogic"><dc:Bounds x="550" y="400" width="100" height="80" /></bpmndi:BPMNShape>
      <!-- Domain Flow -->
      <bpmndi:BPMNShape id="Activity_UpdateBalance_di" bpmnElement="Activity_UpdateBalance"><dc:Bounds x="550" y="560" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Audit_di" bpmnElement="Activity_Audit"><dc:Bounds x="700" y="560" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_Notify_di" bpmnElement="Activity_Notify"><dc:Bounds x="850" y="560" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_Success_di" bpmnElement="EndEvent_Success"><dc:Bounds x="1100" y="582" width="36" height="36" /></bpmndi:BPMNShape>
      <!-- Sequence Flows -->
      <bpmndi:BPMNEdge id="Flow_U1_di" bpmnElement="Flow_U1"><di:waypoint x="246" y="168" /><di:waypoint x="300" y="168" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_U2_di" bpmnElement="Flow_U2"><di:waypoint x="400" y="168" /><di:waypoint x="650" y="168" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="246" y="360" /><di:waypoint x="300" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="400" y="360" /><di:waypoint x="455" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_New_di" bpmnElement="F_New"><di:waypoint x="480" y="335" /><di:waypoint x="480" y="330" /><di:waypoint x="550" y="330" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_Exists_di" bpmnElement="F_Exists"><di:waypoint x="505" y="360" /><di:waypoint x="750" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="650" y="330" /><di:waypoint x="700" y="330" /><di:waypoint x="700" y="360" /><di:waypoint x="750" y="360" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W3_di" bpmnElement="W3"><di:waypoint x="600" y="480" /><di:waypoint x="600" y="560" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W4_di" bpmnElement="W4"><di:waypoint x="650" y="600" /><di:waypoint x="700" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W5_di" bpmnElement="W5"><di:waypoint x="800" y="600" /><di:waypoint x="850" y="600" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="W_End_di" bpmnElement="W_End"><di:waypoint x="950" y="600" /><di:waypoint x="1100" y="600" /></bpmndi:BPMNEdge>
      <!-- Message Flows -->
      <bpmndi:BPMNEdge id="Flow_Request_di" bpmnElement="Flow_Request"><di:waypoint x="350" y="208" /><di:waypoint x="350" y="275" /><di:waypoint x="228" y="275" /><di:waypoint x="228" y="342" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Webhook_di" bpmnElement="Flow_Webhook"><di:waypoint x="228" y="730" /><di:waypoint x="228" y="458" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
