<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_SRS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_SRS">
    <bpmn:participant id="Participant_SRS" name="Quy trình học thích ứng SRS (Algorithm SM-2)" processRef="Process_SRS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_SRS" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User" name="Học viên">
        <bpmn:flowNodeRef>Start_SRS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RateQuality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Mastered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Scheduled</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend" name="Backend (SRS Engine)">
        <bpmn:flowNodeRef>Task_GetDueCards</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Quality</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Mastery</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetMastered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ScheduleNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcNewEF</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResetInterval</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_SRS" name="Tới hạn ôn tập">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_GetDueCards" name="Lấy danh sách từ (Due &#60;= Today)">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="Start_SRS" targetRef="Task_GetDueCards" />
    <bpmn:userTask id="Task_RateQuality" name="Đánh giá mức độ thuộc (0 - 5)">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_GetDueCards" targetRef="Task_RateQuality" />
    <bpmn:exclusiveGateway id="Gateway_Quality" name="Quality &#60; 3?">
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_Fail</bpmn:outgoing>
      <bpmn:outgoing>Flow_Pass</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_RateQuality" targetRef="Gateway_Quality" />
    <bpmn:sequenceFlow id="Flow_Fail" name="Có (Quên từ)" sourceRef="Gateway_Quality" targetRef="Task_ResetInterval" />
    <bpmn:sequenceFlow id="Flow_Pass" name="Không (Thuộc)" sourceRef="Gateway_Quality" targetRef="Task_CalcNewEF" />
    <bpmn:exclusiveGateway id="Gateway_Mastery" name="Đạt ngưỡng thuộc lòng?">
      <bpmn:incoming>Flow_CheckMastery</bpmn:incoming>
      <bpmn:outgoing>Flow_Mastered</bpmn:outgoing>
      <bpmn:outgoing>Flow_NotMastered</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_CheckMastery" sourceRef="Task_CalcNewEF" targetRef="Gateway_Mastery" />
    <bpmn:serviceTask id="Task_SetMastered" name="Mark Mastered (NextReview = Max)">
      <bpmn:incoming>Flow_Mastered</bpmn:incoming>
      <bpmn:outgoing>Flow_ToFinalEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Mastered" name="Có" sourceRef="Gateway_Mastery" targetRef="Task_SetMastered" />
    <bpmn:serviceTask id="Task_ScheduleNext" name="Tính NextReviewDate (Today + Interval)">
      <bpmn:incoming>Flow_NotMastered</bpmn:incoming>
      <bpmn:incoming>Flow_ToSchedule1</bpmn:incoming>
      <bpmn:outgoing>Flow_ToEndScheduled</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_NotMastered" name="Chưa" sourceRef="Gateway_Mastery" targetRef="Task_ScheduleNext" />
    <bpmn:sequenceFlow id="Flow_ToSchedule1" sourceRef="Task_ResetInterval" targetRef="Task_ScheduleNext" />
    <bpmn:endEvent id="End_Mastered" name="Thuộc vĩnh viễn">
      <bpmn:incoming>Flow_ToFinalEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToFinalEnd" sourceRef="Task_SetMastered" targetRef="End_Mastered" />
    <bpmn:endEvent id="End_Scheduled" name="Đã hẹn ngày gặp lại">
      <bpmn:incoming>Flow_ToEndScheduled</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_ToEndScheduled" sourceRef="Task_ScheduleNext" targetRef="End_Scheduled" />
    <bpmn:serviceTask id="Task_CalcNewEF" name="Tính EF &#38; Interval mới (EF x Interval)">
      <bpmn:incoming>Flow_Pass</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckMastery</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ResetInterval" name="Reset Interval = 1 ngày">
      <bpmn:incoming>Flow_Fail</bpmn:incoming>
      <bpmn:outgoing>Flow_ToSchedule1</bpmn:outgoing>
    </bpmn:serviceTask>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_SRS">
      <bpmndi:BPMNShape id="Participant_SRS_di" bpmnElement="Participant_SRS" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="1080" height="420" />
