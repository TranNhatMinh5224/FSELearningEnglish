    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ValidateBalance" targetRef="Gateway_BalanceCheck" />
    <bpmn:endEvent id="End_Failed_Balance" name="Thất bại (Số dư thấp)">
