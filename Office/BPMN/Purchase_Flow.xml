    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_No" name="Không" sourceRef="Gateway_BalanceCheck" targetRef="End_Failed_Balance" />
    <bpmn:subProcess id="SubProcess_Transaction" name="Transaction Zone (Atomic)">
      <bpmn:incoming>Flow_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Success</bpmn:outgoing>
      <bpmn:startEvent id="Start_Tx">
        <bpmn:outgoing>Flow_T1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_SpendWallet" name="Trừ tiền Ví (SpendAsync)">
