        <bpmn:outgoing>Flow_T2</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_T1" sourceRef="Start_Tx" targetRef="Task_SpendWallet" />
      <bpmn:serviceTask id="Task_AddAccess" name="Cấp quyền (Enroll/Upgrade)">
        <bpmn:incoming>Flow_T2</bpmn:incoming>
        <bpmn:outgoing>Flow_T3</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:sequenceFlow id="Flow_T2" sourceRef="Task_SpendWallet" targetRef="Task_AddAccess" />
      <bpmn:endEvent id="End_Tx">
        <bpmn:incoming>Flow_T3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_T3" sourceRef="Task_AddAccess" targetRef="End_Tx" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Yes" name="Có" sourceRef="Gateway_BalanceCheck" targetRef="SubProcess_Transaction" />
    <bpmn:boundaryEvent id="Event_TxError" name="Lỗi nghiệp vụ" attachedToRef="SubProcess_Transaction">
      <bpmn:outgoing>Flow_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_1" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Rollback" name="Hoàn tiền ví (Rollback)">
      <bpmn:incoming>Flow_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_EndError</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Error" sourceRef="Event_TxError" targetRef="Task_Rollback" />
    <bpmn:endEvent id="End_FinalError" name="Giao dịch thất bại">
      <bpmn:incoming>Flow_EndError</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_EndError" sourceRef="Task_Rollback" targetRef="End_FinalError" />
    <bpmn:serviceTask id="Task_NotifySuccess" name="Gửi Notification thành công">
      <bpmn:incoming>Flow_Success</bpmn:incoming>
      <bpmn:outgoing>Flow_Final</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Success" sourceRef="SubProcess_Transaction" targetRef="Task_NotifySuccess" />
    <bpmn:endEvent id="End_Success" name="Hoàn tất">
      <bpmn:incoming>Flow_Final</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Final" sourceRef="Task_NotifySuccess" targetRef="End_Success" />
