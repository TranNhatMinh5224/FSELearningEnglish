<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Security_v2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.13.2">
  <bpmn:collaboration id="Collaboration_Security">
    <bpmn:participant id="Participant_Security" name="Quy trình Identity Security (Xác thực OTP &#38; Resend Loop)" processRef="Process_Security" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Security" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_User_Sec" name="Người dùng">
        <bpmn:flowNodeRef>Start_Register</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InputOTP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_SecuritySuccess</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestResend</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Backend_Sec" name="Backend (Auth Service)">
        <bpmn:flowNodeRef>Task_ValidateInfo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CheckRateLimit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenerateOTP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OTPValidation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_VerifyAccount</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_RateLimitBlocked</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_External_Sec" name="Email Service">
        <bpmn:flowNodeRef>Task_SendOTP</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendWelcome</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Register" name="Nhấn Đăng ký">
      <bpmn:outgoing>Flow_S1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidateInfo" name="Kiểm tra Email/Phone tồn tại">
      <bpmn:incoming>Flow_S1</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRateLimit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_S1" sourceRef="Start_Register" targetRef="Task_ValidateInfo" />
    <bpmn:serviceTask id="Task_CheckRateLimit" name="Kiểm tra Cooldown (Memory Cache)">
      <bpmn:incoming>Flow_ToRateLimit</bpmn:incoming>
      <bpmn:incoming>Flow_ResendRequest</bpmn:incoming>
      <bpmn:outgoing>Flow_RateLimit_OK</bpmn:outgoing>
      <bpmn:outgoing>Flow_RateLimit_Blocked</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_ToRateLimit" sourceRef="Task_ValidateInfo" targetRef="Task_CheckRateLimit" />
    <bpmn:serviceTask id="Task_GenerateOTP" name="Tạo mã OTP (6 số) &#38; Set Timeout (5p)">
      <bpmn:incoming>Flow_RateLimit_OK</bpmn:incoming>
      <bpmn:outgoing>Flow_S3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_RateLimit_OK" name="Hợp lệ" sourceRef="Task_CheckRateLimit" targetRef="Task_GenerateOTP" />
    <bpmn:endEvent id="End_RateLimitBlocked" name="Chặn Spam (HTTP 429)">
      <bpmn:incoming>Flow_RateLimit_Blocked</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RateLimit_Blocked" name="Spam" sourceRef="Task_CheckRateLimit" targetRef="End_RateLimitBlocked" />
    <bpmn:serviceTask id="Task_SendOTP" name="Gửi OTP qua Email">
      <bpmn:incoming>Flow_S3</bpmn:incoming>
      <bpmn:outgoing>Flow_S4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_S3" sourceRef="Task_GenerateOTP" targetRef="Task_SendOTP" />
    <bpmn:userTask id="Task_InputOTP" name="Nhập mã OTP từ Email">
      <bpmn:incoming>Flow_S4</bpmn:incoming>
      <bpmn:outgoing>Flow_S5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_S4" sourceRef="Task_SendOTP" targetRef="Task_InputOTP" />
    <bpmn:exclusiveGateway id="Gateway_OTPValidation" name="Xác thực mã OTP?">
      <bpmn:incoming>Flow_S5</bpmn:incoming>
      <bpmn:outgoing>Flow_OTP_Wrong</bpmn:outgoing>
      <bpmn:outgoing>Flow_OTP_Right</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_S5" sourceRef="Task_InputOTP" targetRef="Gateway_OTPValidation" />
    <bpmn:userTask id="Task_RequestResend" name="Yêu cầu gửi lại mã (Resend)">
      <bpmn:incoming>Flow_OTP_Wrong</bpmn:incoming>
      <bpmn:outgoing>Flow_ResendRequest</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_OTP_Wrong" name="Sai/Hết hạn" sourceRef="Gateway_OTPValidation" targetRef="Task_RequestResend" />
    <bpmn:sequenceFlow id="Flow_ResendRequest" sourceRef="Task_RequestResend" targetRef="Task_CheckRateLimit" />
    <bpmn:serviceTask id="Task_VerifyAccount" name="Update EmailVerified = True">
      <bpmn:incoming>Flow_OTP_Right</bpmn:incoming>
      <bpmn:outgoing>Flow_S6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_OTP_Right" name="Chính xác" sourceRef="Gateway_OTPValidation" targetRef="Task_VerifyAccount" />
    <bpmn:serviceTask id="Task_SendWelcome" name="Gửi Email Chào mừng">
      <bpmn:incoming>Flow_S6</bpmn:incoming>
      <bpmn:outgoing>Flow_FinalS</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_S6" sourceRef="Task_VerifyAccount" targetRef="Task_SendWelcome" />
    <bpmn:endEvent id="End_SecuritySuccess" name="Kích hoạt thành công">
      <bpmn:incoming>Flow_FinalS</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_FinalS" sourceRef="Task_SendWelcome" targetRef="End_SecuritySuccess" />
  </bpmn:process>
