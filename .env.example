# Catalunya English - Full Stack Environment Configuration
# Copy this file to .env and update the secrets before running docker-compose

# --- Database (Postgres) ---
DB_USER=postgres
DB_PASSWORD=05022004
DB_NAME=ElearningEnglish2004
DB_PORT=5433

# --- Storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BROWSER_PORT=9001
MINIO_API_PORT=9000

# --- AI & External Services (SECRETS) ---
# Get these from Google AI Studio, Azure Portal, and PayOS Dashboard
GEMINI_API_KEY=your_gemini_api_key_here
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# --- Auth ---
JWT_KEY=AtLeast32CharactersLongSecretKeyHere!
JWT_ISSUER=ELearningEnglish
JWT_AUDIENCE=ELearningEnglishAudience

# --- Frontend ---
REACT_APP_API_BASE_URL=http://localhost:5030/api
